# Copy to .env and fill in as needed. .env is gitignored.
# The app runs fully in demo mode with NONE of these set.

# Which ingestion source to poll: "demo" (bundled fixtures) or "instagram".
# Default: demo
SOURCE=demo

# Local server port. Default: 8787
PORT=8787

# Poll interval for `npm run dev`, in milliseconds. Default: 60000 (60s)
POLL_INTERVAL_MS=60000

# Confidence at or above which a `noise`-routed message is hidden from the
# default view. Default: 1.1 (impossible, so nothing is ever hidden until you
# lower it). Hidden means filtered from the default view only, never deleted.
ARCHIVE_THRESHOLD=1.1

# --- Classifier --------------------------------------------------------------
# The app runs fully without these — messages just stay "unclassified" until a
# key is set. Any OpenAI-compatible endpoint works; swapping providers is a
# base-URL change.
# GROQ_API_KEY=            # get one free at https://console.groq.com/keys
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Instagram source (added in phase 5) -------------------------------------
# IG_ACCESS_TOKEN=
# IG_ACCOUNT_ID=
